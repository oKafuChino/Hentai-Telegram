# ========================================================
# Hentai-Telegram / Pipeline 环境变量配置
# ========================================================

# --- Telegram Bot 与发布目标频道配置 ---
# Bot Token（由 @BotFather 获取）
TELEGRAM_BOT_TOKEN=123456789:ABCDEF...
# 管理员数字 ID（可通过 @userinfobot 获取），逗号分隔
TELEGRAM_ALLOWED_USER_IDS=123456789
# 正式发布目标 Telegram 频道 ID（例如 -1002222222222 或 @my_manga_channel）
TELEGRAM_CHANNEL_ID=-1002222222222

# 命令行流水线别名（与上方对应，可互通）
TG_BOT_TOKEN=123456789:ABCDEF...
TG_MAIN_CHAT_ID=-1002222222222

# --- Cloudflare R2 / S3 兼容对象存储配置 ---
# R2 账号 ID (在 Cloudflare Dashboard -> R2 概览页右侧获取)
R2_ACCOUNT_ID=your_cloudflare_account_id
# R2 访问密钥 ID (Access Key ID)
R2_ACCESS_KEY_ID=your_r2_access_key
# R2 机密访问密钥 (Secret Access Key)
R2_SECRET_ACCESS_KEY=your_r2_secret_key
# 存储桶名称
R2_BUCKET_NAME=manga-bucket
# 自定义公开访问域名 (在 R2 存储桶设置 -> 公开访问 -> 自定义域中绑定，如 https://img.yourdomain.com)
R2_CUSTOM_DOMAIN=https://img.yourdomain.com

# 通用 S3 变量名 (若使用 Backblaze B2 或 MinIO，与上方 R2 互通)
# S3_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
# S3_BUCKET_NAME=manga-bucket
# S3_ACCESS_KEY_ID=your_key_id
# S3_SECRET_ACCESS_KEY=your_secret_key
# S3_PUBLIC_URL=https://img.yourdomain.com
# S3_REGION_NAME=auto
# S3_KEY_PREFIX=manga/

# --- 图像智能压缩与切片优化 ---
# 是否启用图片体积优化（默认 true，自动进行 Progressive JPEG 压缩与灰度优化，减除 50%-80% 体积）
IMAGE_OPTIMIZE_ENABLED=true
# 黑白漫画页面最大宽度限制（px）
MAX_WIDTH_BW=1280
# 彩色漫画页面最大宽度限制（px）
MAX_WIDTH_COLOR=1440
# 黑白页压缩质量 (50-95，默认 75)
QUALITY_BW=75
# 彩页压缩质量 (50-95，默认 80)
QUALITY_COLOR=80
# 灰度判别阈值（计算 R-G 与 G-B 通道均值差，小于此值判定为黑白页并转为单通道）
GRAYSCALE_THRESHOLD=3.5
# 条漫切片高度阈值 (px，高度超过此值横向切片，尾段不足 300px 自动并入上一段)
MAX_SLICE_HEIGHT=2400
# CPU 图像处理并发进程数 (推荐 2~4，防止小内存 VPS 触发 OOM)
CPU_WORKERS=2
# 对象存储并发上传线程数
IO_UPLOAD_WORKERS=16

# --- Telegraph 与分页配置 ---
TELEGRAPH_SHORT_NAME=MangaBot
TELEGRAPH_AUTHOR_NAME=漫画频道
TELEGRAPH_AUTHOR_URL=
TELEGRAPH_ACCESS_TOKEN=       # 留空则首次运行自动生成并打印提示保存
TELEGRAPH_MAX_IMAGES_PER_PAGE=100

# --- 存储与本地数据库配置 ---
DATABASE_URL=sqlite+aiosqlite:///./data/app/hentai_telegram.db
STORAGE_ROOT=/storage
DOWNLOAD_CONCURRENCY=2
RETRY_MAX_ATTEMPTS=3
MIN_FREE_SPACE_GB=2
RESUME_FREE_SPACE_GB=5
DISK_SPACE_CHECK_ENABLED=false
LOG_LEVEL=INFO

# 禁漫 API 自定义域名（可选）
JM_API_DOMAINS=
APP_UID=1000
APP_GID=1000
