# Telegram Bot 配置
TELEGRAM_BOT_TOKEN=your_bot_token_here
# 管理员 Telegram 数字用户 ID，逗号分隔（只有管理员可以使用此 Bot）
TELEGRAM_ALLOWED_USER_IDS=123456789
# 发布目标 Telegram 频道 ID 或 @用户名（例如 -1001234567890 或 @my_manga_channel）
TELEGRAM_CHANNEL_ID=-1001234567890

# ========================================================
# 对象存储图床配置（推荐：Cloudflare R2 或 Backblaze B2）
# 配置后所有漫画章节图片将直接保存在您的 R2/B2 桶中，由 Telegraph 引用阅读
# 未配置时自动回退使用 Catbox 公共图床
# ========================================================
# S3 兼容 Endpoint 地址：
# - Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# - Backblaze B2: https://s3.<REGION>.backblazeb2.com（例如 https://s3.us-west-004.backblazeb2.com）
S3_ENDPOINT_URL=
# 存储桶名称 (Bucket Name)
S3_BUCKET_NAME=
# Access Key ID（R2 访问密钥 ID 或 B2 KeyID）
S3_ACCESS_KEY_ID=
# Secret Access Key（R2 机密访问密钥 或 B2 ApplicationKey）
S3_SECRET_ACCESS_KEY=
# 图片公开访问 URL（用于 Telegraph 在线阅读图片）：
# - Cloudflare R2: 绑定的自定义域名（如 https://img.yourdomain.com）或 R2 临时域名（https://pub-xxx.r2.dev）
# - Backblaze B2: 套 Cloudflare 的自定义域名或 B2 文件直链（如 https://f004.backblazeb2.com/file/<bucket_name>）
S3_PUBLIC_URL=
# 区域（Cloudflare R2 填 auto；Backblaze B2 填相应 region 如 us-west-004）
S3_REGION_NAME=auto
# 存储 Key 前缀（默认为 manga/）
S3_KEY_PREFIX=manga/

# Telegraph 配置
# 发布者名称（显示在 Telegraph 文章顶部）
TELEGRAPH_AUTHOR_NAME=Hentai-Telegram
# 发布者链接（可填频道链接，例如 https://t.me/my_channel）
TELEGRAPH_AUTHOR_URL=
# Telegraph Access Token（留空则初次启动自动创建并持久化）
TELEGRAPH_ACCESS_TOKEN=
# 图片上传服务地址（官方 telegra.ph/upload 已于 2024 年下线，默认使用 Catbox: https://catbox.moe/user/api.php，也可填写自建 Telegraph 代理）
TELEGRAPH_UPLOAD_URL=https://catbox.moe/user/api.php
# Catbox 用户 hash（可选，若有 catbox.moe 账号可填入，以便在账户中管理上传的文件）
CATBOX_USERHASH=
# Telegraph API 地址
TELEGRAPH_API_URL=https://api.telegra.ph

# 图片画质与体积优化配置
# 是否启用图片体积优化（默认 true，自动进行渐进式高画质压缩，降低 50%-80% 体积且不影响肉眼观感）
IMAGE_OPTIMIZE_ENABLED=true
# 压缩画质质量（50-95，默认 85，在清晰度与体积之间达到最佳平衡）
IMAGE_JPEG_QUALITY=85
# 图片最大宽度像素（默认 1600，超大扫描图等比例缩放适配手机/平板视网膜屏，设为 0 则不缩放分辨率）
IMAGE_MAX_WIDTH=1600
# 触发压缩的最小文件大小（字节，默认 102400 即 100KB，低于该大小且合规的文件跳过处理）
IMAGE_MIN_COMPRESS_BYTES=102400

# 存储与并发配置
DATABASE_URL=sqlite+aiosqlite:///./data/app/hentai_telegram.db
STORAGE_ROOT=/storage
DOWNLOAD_CONCURRENCY=2
RETRY_MAX_ATTEMPTS=3
MIN_FREE_SPACE_GB=2
RESUME_FREE_SPACE_GB=5
DISK_SPACE_CHECK_ENABLED=false
LOG_LEVEL=INFO

# 禁漫 API 域名配置（可选，遇到默认 API 域名不可达时填入，逗号分隔）
JM_API_DOMAINS=
APP_UID=1000
APP_GID=1000
